ape>daily<escape>,<escape>weekly<escape>,<escape>monthly<escape>,<escape>yearly<escape>],type:<escape>STRING<escape>},recurrence_interval:{description:<escape>Repeat every N periods (2 = every other). Default 1.<escape>,type:<escape>INTEGER<escape>},recurrence_until:{description:<escape>Last date of the series, MM-DD or YYYY-MM-DD. Not with recurrence_count.<escape>,type:<escape>STRING<escape>},time:{description:<escape>Start time as said, 24-hour HH:MM.<escape>,type:<escape>STRING<escape>},title:{description:<escape>Short event title, as the user named it.<escape>,type:<escape>STRING<escape>}},required:[<escape>title<escape>,<escape>time<escape>],type:<escape>OBJECT<escape>}}<end_function_declaration><end_of_turn>
